{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://value-investment-agent.local/contracts/workflow-interaction-v1.schema.json",
  "title": "workflow.interaction v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "seq_id", "event_version", "event_name", "thread_id", "run_id", "occurred_at", "payload"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "seq_id": {"type": "integer", "minimum": 1},
    "event_version": {"const": "v1"},
    "event_name": {"const": "workflow.interaction"},
    "thread_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "kind", "status", "request"],
      "properties": {
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["thread_id", "run_id", "activity_id", "interaction_id"],
          "properties": {
            "thread_id": {"type": "string", "minLength": 1},
            "run_id": {"type": "string", "minLength": 1},
            "activity_id": {"type": "string", "minLength": 1},
            "interaction_id": {"type": "string", "minLength": 1, "maxLength": 200}
          }
        },
        "kind": {"const": "ticker_selection"},
        "status": {"enum": ["pending", "responded", "cancelled"]},
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "title", "description", "candidates"],
          "properties": {
            "type": {"const": "ticker_selection"},
            "title": {"type": "string", "minLength": 1, "maxLength": 160},
            "description": {"type": "string", "minLength": 1, "maxLength": 500},
            "candidates": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["symbol", "name", "confidence"],
                "properties": {
                  "symbol": {"type": "string", "minLength": 1, "maxLength": 32},
                  "name": {"type": "string", "minLength": 1, "maxLength": 160},
                  "exchange": {"type": ["string", "null"]},
                  "type": {"type": ["string", "null"]},
                  "confidence": {"type": "number", "minimum": 0, "maximum": 1}
                }
              }
            }
          }
        },
        "response": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["type", "selected_symbol"],
          "properties": {
            "type": {"const": "ticker_selection"},
            "selected_symbol": {"type": "string", "minLength": 1, "maxLength": 32}
          }
        }
      }
    }
  }
}
