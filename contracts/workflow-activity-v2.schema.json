{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://value-investment-agent.local/contracts/workflow-activity-v2.schema.json",
  "title": "workflow.activity v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "seq_id", "event_version", "event_name", "thread_id", "run_id", "occurred_at", "payload"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "seq_id": {"type": "integer", "minimum": 1},
    "event_version": {"const": "v2"},
    "event_name": {"const": "workflow.activity"},
    "thread_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activity_id", "thread_id", "run_id", "scope_path", "kind", "status", "label", "attempt"],
      "properties": {
        "activity_id": {"type": "string", "minLength": 1},
        "parent_activity_id": {"type": ["string", "null"], "minLength": 1},
        "thread_id": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "scope_path": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "kind": {"enum": ["phase", "node", "tool", "subgraph"]},
        "status": {"enum": ["queued", "running", "waiting", "completed", "failed", "cancelled", "skipped"]},
        "label": {"type": "string", "minLength": 1, "maxLength": 160},
        "progress": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "attempt": {"type": "integer", "minimum": 1}
      }
    }
  }
}
