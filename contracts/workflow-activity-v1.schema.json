{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://value-investment-agent.local/contracts/workflow-activity-v1.schema.json",
  "title": "workflow.activity v1",
  "description": "Application-owned durable activity event and snapshot contract plus shared behavior fixtures.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "event_name", "activity_statuses", "activity_kinds", "scenarios"],
  "properties": {
    "contract_version": {
      "const": "v1"
    },
    "event_name": {
      "const": "workflow.activity"
    },
    "activity_statuses": {
      "type": "array",
      "const": ["queued", "running", "waiting", "completed", "failed", "cancelled", "skipped"]
    },
    "activity_kinds": {
      "type": "array",
      "const": ["phase", "node", "tool", "subgraph"]
    },
    "scenarios": {
      "type": "array",
      "minItems": 11,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activity_id", "thread_id", "run_id", "scope_path", "kind", "status", "label", "attempt"],
      "properties": {
        "activity_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "parent_activity_id": {
          "type": "string",
          "minLength": 1
        },
        "thread_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "scope_path": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "kind": {
          "enum": ["phase", "node", "tool", "subgraph"]
        },
        "status": {
          "enum": ["queued", "running", "waiting", "completed", "failed", "cancelled", "skipped"]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "activityEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "seq_id", "event_version", "event_name", "thread_id", "run_id", "occurred_at", "payload"],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "seq_id": {
          "type": "integer",
          "minimum": 1
        },
        "event_version": {
          "const": "v1"
        },
        "event_name": {
          "const": "workflow.activity"
        },
        "thread_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "$ref": "#/$defs/activity"
        }
      }
    },
    "activitySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thread_id", "run_id", "run_status", "cursor", "active_activities", "recent_activities"],
      "properties": {
        "thread_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "run_status": {
          "enum": ["queued", "running", "waiting", "completed", "failed", "cancelled"]
        },
        "cursor": {
          "type": "integer",
          "minimum": 0
        },
        "active_activities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/activity"
          }
        },
        "recent_activities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/activity"
          }
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "events", "snapshot", "assertions"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/activityEvent"
          }
        },
        "snapshot": {
          "$ref": "#/$defs/activitySnapshot"
        },
        "assertions": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
