# Copy this file to .env for local Docker Compose development.
# Keep real credentials in .env. Never commit .env or production secrets.

# Generate a Fernet key before starting the embedded LLM provider service.
# OpenRouter user keys are added in the app's LLM settings.
LLM_PROVIDER_ENCRYPTION_KEY=replace-with-generated-fernet-key

# These tokens must match between the backend and their internal services.
INFERENCE_SERVICE_TOKEN=local-inference-only-change-me
LLM_PROVIDER_SERVICE_TOKEN=local-development-only-token
SEARCH_SERVICE_TOKEN=local-development-only-token
DIRECTORY_CURSOR_SECRET=local-development-only-directory-cursor-secret
AUDIT_CURSOR_SECRET=local-development-only-audit-cursor-secret

# Generate a Fernet key before using managed Search provider credentials.
# See README.md for the generation command.
SEARCH_PROVIDER_ENCRYPTION_KEY=

# Optional macro-data credential. Core market data uses other sources without it.
FRED_API_KEY=

# Local database defaults. Change these when exposing a shared development stack.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=langgraph

# Published host ports. Assign unique values for each concurrent worktree.
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
LLM_PROVIDER_SERVICE_HOST_PORT=8002
SEARCH_SERVICE_HOST_PORT=8003

# Optional override; by default Compose derives both localhost aliases from FRONTEND_HOST_PORT.
# FRONTEND_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
APP_ENV=development

# Optional credentials used only by scripts/refactor_staging_smoke.sh.
# The smoke script creates a test account and registers these keys when needed.
STAGING_EMAIL=test@example.com
STAGING_PASSWORD=replace-with-a-test-account-password
STAGING_OPENROUTER_KEY=
STAGING_SECONDARY_OPENROUTER_KEY=
STAGING_PRIMARY_LABEL=full-refactor-staging-primary
STAGING_SECONDARY_LABEL=full-refactor-staging-secondary
